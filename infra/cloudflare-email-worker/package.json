{
  "name": "homefinder-email-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloudflare Email Worker + D1 queue for HomeFinder alert-email ingestion. Deliberately outside the pnpm workspace.",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply homefinder-email-queue --local",
    "db:migrate:remote": "wrangler d1 migrations apply homefinder-email-queue --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "postal-mime": "^2.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250901.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
