# Copy to .env and fill in. .env is git-ignored; never commit real values.

# Supabase "Session pooler" connection string (IPv4). Put the password directly, WITHOUT the [ ] from the template.
SUPABASE_CONNECTIONSTRING=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: enables email alerts (https://resend.com). Free test sender only delivers to your own account address.
RESEND_API_KEY=
#RESEND_FROM=HomeFinder <onboarding@resend.dev>

# Optional: email ingestion for Imovirtual/Supercasa (see docs/cloudflare-email-ingestion.md). Names only, no values here.
CLOUDFLARE_EMAIL_QUEUE_URL=
CLOUDFLARE_EMAIL_QUEUE_TOKEN=

# Web app login and cookie signing
APP_PASSWORD=
AUTH_SECRET=
